# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git — only commit this .env.example

# Security
SECRET_KEY=generate-a-random-key-here
DEBUG=False
FLASK_ENV=production

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///exam_manager.db
# DATABASE_URL=postgresql://exam_user:exam_pass@localhost:5432/exam_manager

# Admin
ADMIN_EMAIL=admin@college.edu
COLLEGE_NAME=AI Smart College

# Session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# WebSocket (optional — for multi-process deployment)
# REDIS_URL=redis://localhost:6379
